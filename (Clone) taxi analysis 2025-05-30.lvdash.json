{
  "datasets": [
    {
      "name": "90a78719",
      "displayName": "taxi analysis",
      "queryLines": [
        "USE CATALOG `main`;",
        "USE SCHEMA `default`;",
        "",
        "SELECT",
        "  T.pickup_zip,",
        "  T.dropoff_zip,",
        "  T.route as `Route`,",
        "  T.frequency as `Number Trips`,",
        "  T.total_fare as `Total Revenue`",
        "FROM",
        "  (",
        "    SELECT",
        "      pickup_zip,",
        "      dropoff_zip,",
        "      concat(pickup_zip, '-', dropoff_zip) AS route,",
        "      count(*) as frequency,",
        "      SUM(fare_amount) as total_fare",
        "    FROM",
        "      `samples`.`nyctaxi`.`trips`",
        "    GROUP BY",
        "      1,",
        "      2,",
        "      3",
        "  ) T",
        "ORDER BY",
        "  1 ASC"
      ],
      "catalog": "main",
      "schema": "default"
    },
